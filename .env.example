# Max requests per second per client IP
RATE_LIMIT_IP=10
# Default max requests per second per token (header API_KEY)
RATE_LIMIT_TOKEN=100
# Optional per-token overrides: token:limit,token:limit
TOKEN_LIMITS=abc123:100,xyz789:50
# How long a client stays blocked after exceeding its limit
BLOCK_DURATION_SECONDS=300
# Redis: REDIS_ADDR wins; otherwise REDIS_HOST:REDIS_PORT
REDIS_ADDR=localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SERVER_PORT=8080
# true: allow requests when Redis fails; false: reject them with 429
FAIL_OPEN=true
